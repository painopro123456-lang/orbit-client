<Window x:Class="Orbit.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ORBIT" Width="1520" Height="960" MinWidth="1240" MinHeight="780"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Background="#080B10" Foreground="#F4F6FB" FontFamily="Segoe UI Variable Display, Segoe UI" Loaded="MainWindow_Loaded">
 <Window.Resources>
  <DropShadowEffect x:Key="SoftShadow" BlurRadius="24" ShadowDepth="5" Opacity="0.22"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#282640"/>
  <SolidColorBrush x:Key="Ink" Color="#080B10"/>
  <SolidColorBrush x:Key="Panel" Color="#101722"/>
  <SolidColorBrush x:Key="PanelRaised" Color="#182231"/>
  <SolidColorBrush x:Key="Stroke" Color="#29384A"/>
  <SolidColorBrush x:Key="Muted" Color="#9AA8BA"/>
  <SolidColorBrush x:Key="Violet" Color="#A99BFF"/>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Foreground" Value="#9DA7B8"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="15,12"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Margin" Value="0,4"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#202B3A"/><Setter Property="Foreground" Value="#F2F3FA"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value=".7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#111A26"/><Setter Property="BorderBrush" Value="#2A394C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="15"/></Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="Foreground" Value="#8994A8"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F5F6FC"/><Setter Property="Background" Value="#1B2230"/>
   <Setter Property="BorderBrush" Value="#303B50"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,10"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#293247"/><Setter TargetName="bd" Property="BorderBrush" Value="#5A6480"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value=".78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#0B1018" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" BorderBrush="#1D2532" BorderThickness="0,0,0,1">
   <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="19,0"><Border Width="18" Height="18" CornerRadius="6" Background="#A99BFF"><TextBlock Text="O" Foreground="#11131A" FontWeight="Black" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="  ORBIT" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="   /   MINECRAFT JAVA" Foreground="#657187" FontSize="9" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="—" Width="46" Padding="0" Background="Transparent" BorderThickness="0" Click="Minimize_Click"/><Button Content="□" Width="46" Padding="0" Background="Transparent" BorderThickness="0" Click="Maximize_Click"/><Button Content="×" Width="46" Padding="0" Background="Transparent" BorderThickness="0" Click="Close_Click"/></StackPanel></Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#0D131D" BorderBrush="#202938" BorderThickness="0,0,1,0">
    <Grid Margin="16,22,16,17"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="26"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="8,0,0,25"><Border Width="38" Height="38" CornerRadius="13" Background="#A99BFF"><TextBlock Text="O" Foreground="#11131A" FontSize="23" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="ORBIT" FontSize="17" FontWeight="Bold"/><TextBlock Text="MINECRAFT, REIMAGINED" FontSize="8" Foreground="#77839A"/></StackPanel></StackPanel>
     <TextBlock Grid.Row="1" Text="YOUR SPACE" Foreground="#69758B" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>
     <StackPanel Grid.Row="2">
      <Button Style="{StaticResource NavButton}" Content="◈    Overview" Background="#222039" Foreground="#E3DFFF" Click="Home_Click"/>
      <Button Style="{StaticResource NavButton}" Content="▦    Instances" Click="Instances_Click"/>
      <Button Style="{StaticResource NavButton}" Content="◇    Mods &amp; Modpacks" Click="Mods_Click"/>
      <Button Style="{StaticResource NavButton}" Content="⌕    Discover" Click="Browse_Click"/>
     </StackPanel>
     <StackPanel Grid.Row="4">
      <Border Height="1" Background="#252D3B" Margin="4,0,4,13"/>
      <Button Style="{StaticResource NavButton}" Content="⚙    Settings" Click="Settings_Click"/>
      <Border Background="#172331" BorderBrush="#2A3548" BorderThickness="1" CornerRadius="16" Padding="14" Margin="4,14,4,0">
       <StackPanel><TextBlock Text="PLAYER PROFILE" Foreground="#7F8BA0" FontSize="9" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,11,0,0"><Border Width="32" Height="32" CornerRadius="10" Background="#252B3B"><TextBlock Text="?" Foreground="#B8C1D1" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="AccountName" Text="Guest player" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="AccountStatus" Text="Microsoft account" FontSize="9" Foreground="#91A1B4"/></StackPanel></StackPanel><Button x:Name="AccountButton" Content="Connect account  ↗" Margin="0,12,0,0" Background="#282440" BorderBrush="#514A7D" Click="SignIn_Click"/></StackPanel>
      </Border>
      <TextBlock Text="ORBIT  /  EARLY ACCESS" Foreground="#505D72" FontSize="8" Margin="10,17,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="38,30,38,30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock x:Name="PageEyebrow" Text="YOUR SPACE" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="PageTitle" Text="A world of your own." FontSize="32" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="PageSubtitle" Text="Your Minecraft setup, beautifully brought together." Foreground="#A0ADBF" FontSize="12" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#151F2B" BorderBrush="#293548" BorderThickness="1" CornerRadius="9" Padding="11,8"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionBadgeDot" Width="6" Height="6" Fill="#D7A85D" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionBadgeText" Text="ACCOUNT NOT CONNECTED" FontSize="9" Foreground="#AAB3C2" FontWeight="SemiBold"/></StackPanel></Border></Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,23,0,0">
     <StackPanel Margin="0,0,0,16">
     <StackPanel x:Name="HomePanel">
      <Border Height="300" CornerRadius="22" ClipToBounds="True" BorderBrush="#393552" BorderThickness="1">
       <Grid>
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#292744" Offset="0"/><GradientStop Color="#1A2030" Offset=".52"/><GradientStop Color="#101720" Offset="1"/></LinearGradientBrush></Grid.Background>
        <Rectangle Opacity=".16"><Rectangle.Fill><RadialGradientBrush Center=".8,.4" RadiusX=".7" RadiusY=".9"><GradientStop Color="#B3A5FF" Offset="0"/><GradientStop Color="#5A528E" Offset=".35"/><GradientStop Color="#1A2030" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
        <Canvas IsHitTestVisible="False" Opacity=".6"><Ellipse Width="390" Height="390" Canvas.Left="590" Canvas.Top="-105" Stroke="#756CB0" StrokeThickness="1"/><Ellipse Width="310" Height="310" Canvas.Left="630" Canvas.Top="-65" Stroke="#5C548E" StrokeThickness="1"/><Ellipse Width="230" Height="230" Canvas.Left="670" Canvas.Top="-25" Stroke="#48436F" StrokeThickness="1"/><Ellipse Width="9" Height="9" Canvas.Left="865" Canvas.Top="82" Fill="#C5BBFF"/><Ellipse Width="4" Height="4" Canvas.Left="702" Canvas.Top="212" Fill="#C5BBFF"/></Canvas>
        <Grid Margin="35,29"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center"><Border Background="#3A355C" BorderBrush="#625A96" BorderThickness="1" CornerRadius="6" Padding="9,5" HorizontalAlignment="Left"><TextBlock Text="A BETTER WAY TO PLAY" Foreground="#D0C9FF" FontSize="8" FontWeight="Bold"/></Border><TextBlock Text="Make room for adventure." FontSize="39" LineHeight="46" FontWeight="SemiBold" Margin="0,17,0,9"/><TextBlock Text="One home for every world, modpack and idea." FontSize="12" Foreground="#B1B7C9"/><StackPanel Orientation="Horizontal" Margin="0,24,0,0"><Button x:Name="PlayButton" Content="▶   PLAY MINECRAFT" Background="#B3A8FF" BorderBrush="#D0C9FF" Foreground="#171522" FontWeight="Bold" Padding="19,13" Click="Play_Click"/><Button Content="Your instances" Background="#262A3B" BorderBrush="#4B506A" Margin="9,0,0,0" Padding="15,13" Click="Instances_Click"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center"><TextBlock Text="VERSION" Foreground="#A7A0D1" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="VersionSelector" Width="112" Height="30" Background="#1A2030" Foreground="#F5F6FC" BorderBrush="#625A96" FontSize="10" SelectionChanged="VersionSelector_SelectionChanged"/></StackPanel></StackPanel>
         <Grid Grid.Column="1" Margin="5,0,0,0"><Border Width="226" Height="226" CornerRadius="113" BorderBrush="#756BAF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid><Ellipse Margin="17" Stroke="#5F578F" StrokeThickness="1"/><Ellipse Margin="39" Stroke="#4B4776" StrokeThickness="1"/><Ellipse Width="105" Height="105" Fill="#24223C" Stroke="#A79BEF" StrokeThickness="1.5"/><TextBlock Text="O" FontSize="67" FontWeight="Light" Foreground="#D0C8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><TextBlock Text="EXPLORE  •  CREATE  •  PLAY" Foreground="#A7A0D1" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/></Grid>
        </Grid>
       </Grid>
      </Border>
      <StackPanel Margin="0,12,0,0"><TextBlock x:Name="ActivityText" Text="Preparing ORBIT…" Foreground="#9AA5B8" FontSize="9" Margin="2,0,0,6"/><ProgressBar x:Name="InstallProgress" Height="4" Minimum="0" Maximum="100" Value="0" Background="#1C2432" Foreground="#A99BFF" BorderThickness="0"/></StackPanel>
      <Grid Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="GAME VERSION" Style="{StaticResource Eyebrow}"/><StackPanel Orientation="Horizontal" Margin="0,9,0,2"><TextBlock x:Name="SelectedVersionText" Text="26.2" FontSize="24" FontWeight="SemiBold"/><Border Background="#202C32" CornerRadius="5" Padding="6,3" Margin="9,7,0,4"><TextBlock Text="TARGET" Foreground="#92CBB0" FontSize="8" FontWeight="Bold"/></Border></StackPanel><TextBlock Text="Choose your Minecraft release" Foreground="#91A1B4" FontSize="9"/></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="4,0"><StackPanel><TextBlock Text="YOUR INSTANCES" Style="{StaticResource Eyebrow}"/><TextBlock Text="Ready when you are" FontSize="16" FontWeight="SemiBold" Margin="0,11,0,3"/><TextBlock Text="Create separate game profiles" Foreground="#91A1B4" FontSize="9"/></StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="8,0,0,0"><StackPanel><TextBlock Text="MOD ECOSYSTEM" Style="{StaticResource Eyebrow}"/><TextBlock Text="Make it yours" FontSize="16" FontWeight="SemiBold" Margin="0,11,0,3"/><TextBlock Text="Modrinth  •  CurseForge" Foreground="#91A1B4" FontSize="9"/></StackPanel></Border>
      </Grid>
      <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Style="{StaticResource Card}" Padding="19" Margin="0,0,8,0"><StackPanel><Grid><TextBlock Text="QUICK START" Style="{StaticResource Eyebrow}"/><TextBlock Text="Your next world is three steps away" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,15"/></Grid><StackPanel Orientation="Horizontal" Margin="0,5"><Border Width="25" Height="25" CornerRadius="8" Background="#282440"><TextBlock Text="1" Foreground="#C5BCFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/></Border><StackPanel Margin="10,0"><TextBlock Text="Connect Microsoft" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Sign in to your Minecraft account" Foreground="#91A1B4" FontSize="9"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" Margin="0,11,0,5"><Border Width="25" Height="25" CornerRadius="8" Background="#202A36"><TextBlock Text="2" Foreground="#AFC4D8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/></Border><StackPanel Margin="10,0"><TextBlock Text="Create an instance" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Pick a version and mod loader" Foreground="#91A1B4" FontSize="9"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" Margin="0,5"><Border Width="25" Height="25" CornerRadius="8" Background="#202A36"><TextBlock Text="3" Foreground="#AFC4D8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/></Border><StackPanel Margin="10,0"><TextBlock Text="Launch and play" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Your worlds, organized in one place" Foreground="#91A1B4" FontSize="9"/></StackPanel></StackPanel></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}" Padding="19" Margin="8,0,0,0"><StackPanel><TextBlock Text="MADE FOR YOUR GAME" Style="{StaticResource Eyebrow}"/><TextBlock Text="A launcher that stays out of your way." FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,8"/><TextBlock Text="Independent instances. Flexible Java and memory settings. Modpacks from the places you already trust. All wrapped in one focused desktop experience." Foreground="#9EACBE" FontSize="10" TextWrapping="Wrap" LineHeight="17"/><Button Content="Explore ORBIT  →" HorizontalAlignment="Left" Margin="0,15,0,0" Click="Browse_Click"/></StackPanel></Border>
      </Grid>
      <TextBlock Text="ORBIT IS IN EARLY ACCESS — FEATURES ARE BEING BUILT." Foreground="#59657A" FontSize="8" HorizontalAlignment="Center" Margin="0,17,0,3"/>
     </StackPanel>
      <StackPanel x:Name="LibraryPanel" Visibility="Collapsed">
       <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
        <Button x:Name="InstancesTabButton" Content="Instances" Background="#282440" BorderBrush="#625A96" Click="InstancesTab_Click"/>
        <Button x:Name="ModpacksTabButton" Content="Modpacks" Margin="8,0,0,0" Click="ModpacksTab_Click"/>
       </StackPanel>
       <StackPanel x:Name="InstancesTabPanel">
        <TextBlock Text="YOUR INSTANCES" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Your game profiles" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,12"/>
        <TextBlock x:Name="InstancesEmptyText" Text="No instances yet. Install a modpack to create your first one." Foreground="#9EACBE" FontSize="11" Margin="0,4,0,14"/>
        <ItemsControl x:Name="InstanceList"/>
        <Button Content="Refresh instances" HorizontalAlignment="Left" Margin="0,12,0,0" Click="RefreshInstances_Click"/>
       </StackPanel>
       <StackPanel x:Name="ModpacksTabPanel" Visibility="Collapsed">
        <TextBlock Text="MODPACK LIBRARY" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Discover your next world." FontSize="19" FontWeight="SemiBold" Margin="0,5,0,6"/>
        <TextBlock Text="Choose a source below. You can switch sources here anytime—no pop-up." Foreground="#9EACBE" FontSize="11" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
         <Button x:Name="ModrinthSourceButton" Content="Modrinth" Background="#282440" BorderBrush="#625A96" Click="ModrinthSource_Click"/>
         <Button x:Name="CurseForgeSourceButton" Content="CurseForge" Margin="8,0,0,0" Click="CurseForgeSource_Click"/>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="20">
         <StackPanel>
          <TextBlock x:Name="ModpackSourceTitle" Text="Modrinth modpacks" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="ModpackSourceDescription" Text="Search, compare and install modpacks without numbered pop-ups." Foreground="#9EACBE" FontSize="10" Margin="0,6,0,15" TextWrapping="Wrap"/>
          <Grid Margin="0,0,0,14">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBox x:Name="ContentSearchBox" Height="42" Padding="13,10" FontSize="12" Background="#0C131D" Foreground="#F4F6FB" BorderBrush="#35445A" BorderThickness="1" VerticalContentAlignment="Center" Text=""/>
           <Button Grid.Column="1" Content="Search" Margin="9,0,0,0" Background="#B3A8FF" Foreground="#171522" FontWeight="Bold" Click="SearchContent_Click"/>
          </Grid>
          <TextBlock x:Name="SearchStatusText" Text="Search Modrinth or CurseForge to discover modpacks." Foreground="#93A1B5" FontSize="10" Margin="0,0,0,10"/>
          <ListBox x:Name="SearchResultsList" Background="Transparent" BorderThickness="0" Foreground="#F4F6FB" MinHeight="80" MaxHeight="330" SelectionMode="Single" SelectionChanged="SearchResultsList_SelectionChanged">
           <ListBox.ItemTemplate><DataTemplate><Border Background="#172231" BorderBrush="#2C3B4E" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="#9EACBE" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding Meta}" Foreground="#B8ACFF" FontSize="9" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
           <Button x:Name="InstallSelectedButton" Content="Install selected modpack" Background="#B3A8FF" BorderBrush="#D0C9FF" Foreground="#171522" FontWeight="Bold" Click="InstallSelected_Click" IsEnabled="False"/>
           <Button Content="Installed mods  →" Margin="9,0,0,0" Click="OpenInstalledMods_Click"/>
          </StackPanel>
         </StackPanel>
        </Border>
       </StackPanel>
       <StackPanel x:Name="InstalledModsPanel" Visibility="Collapsed">
        <TextBlock Text="MOD MANAGER" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Manage your installed mods." FontSize="19" FontWeight="SemiBold" Margin="0,5,0,6"/>
        <TextBlock Text="Choose an instance, then enable, disable or remove its JAR files." Foreground="#9EACBE" FontSize="11" Margin="0,0,0,14"/>
        <ComboBox x:Name="ModInstanceSelector" Height="38" Background="#151F2B" Foreground="#F4F6FB" BorderBrush="#35445A" SelectionChanged="ModInstanceSelector_SelectionChanged"/>
        <ListBox x:Name="InstalledModsList" Background="Transparent" BorderThickness="0" Foreground="#F4F6FB" MinHeight="100" MaxHeight="430" Margin="0,14,0,0">
         <ListBox.ItemTemplate><DataTemplate><Border Background="#172231" BorderBrush="#2C3B4E" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding State}" Foreground="#9EACBE" FontSize="9" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding FileSize}" Foreground="#9EACBE" FontSize="9" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
         <Button Content="Enable / disable" Click="ToggleMod_Click"/>
         <Button Content="Remove mod" Margin="8,0,0,0" Click="RemoveMod_Click"/>
         <Button Content="Back to modpacks" Margin="8,0,0,0" Click="BackToModpacks_Click"/>
        </StackPanel>
       </StackPanel>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>
 </Grid>
</Window>