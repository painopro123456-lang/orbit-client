<Window x:Class="Orbit.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ORBIT" Width="1440" Height="900" MinWidth="1120" MinHeight="720"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Background="{StaticResource Bg}" Foreground="{StaticResource TextPrimary}">
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="15,12"/>
   <Setter Property="Margin" Value="0,3"/>
  </Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="Foreground" Value="#8994A8"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="CharacterSpacing" Value="140"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#0D1017" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
   <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0"><Border Width="19" Height="19" CornerRadius="6" Background="#9A8CFF"><TextBlock Text="O" Foreground="#10121A" FontWeight="Black" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="  ORBIT" FontWeight="Bold" FontSize="12" CharacterSpacing="100" VerticalAlignment="Center"/><TextBlock Text="  /  MINECRAFT JAVA" Foreground="#697386" FontSize="10" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="—" Width="46" Padding="0" Background="Transparent" BorderThickness="0" Click="Minimize_Click"/><Button Content="□" Width="46" Padding="0" Background="Transparent" BorderThickness="0" Click="Maximize_Click"/><Button Content="×" Width="46" Padding="0" Background="Transparent" BorderThickness="0" Click="Close_Click"/></StackPanel></Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#0F131B" BorderBrush="#202735" BorderThickness="0,0,1,0">
    <Grid Margin="16,22">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="28"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="8,0,0,18"><Border Width="36" Height="36" CornerRadius="11" Background="#9A8CFF"><TextBlock Text="O" Foreground="#11131B" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="ORBIT" FontSize="17" FontWeight="Bold" CharacterSpacing="120"/><TextBlock Text="MINECRAFT LAUNCHER" FontSize="9" Foreground="#768197" CharacterSpacing="80"/></StackPanel></StackPanel>
     <TextBlock Grid.Row="1" Text="WORKSPACE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="10,0"/>
     <StackPanel Grid.Row="2">
      <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Content="  ◈     Overview" Background="#202034" BorderBrush="#383455" Click="Home_Click"/>
      <Button Style="{StaticResource NavButton}" Content="  ▦     Instances" Click="Instances_Click"/>
      <Button Style="{StaticResource NavButton}" Content="  ◇     Mods &amp; Modpacks" Click="Mods_Click"/>
      <Button Style="{StaticResource NavButton}" Content="  ▤     Browse" Click="Browse_Click"/>
     </StackPanel>
     <StackPanel Grid.Row="4">
      <Border Height="1" Background="#252D3B" Margin="4,0,4,14"/>
      <Button Style="{StaticResource NavButton}" Content="  ⚙     Settings" Click="Settings_Click"/>
      <Border Background="#171D29" BorderBrush="#283143" BorderThickness="1" CornerRadius="12" Padding="12" Margin="4,15,4,0">
       <StackPanel><TextBlock Text="YOUR ACCOUNT" FontSize="9" Foreground="#7D899D" FontWeight="Bold" CharacterSpacing="90"/><TextBlock Text="Not signed in" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="Connect Microsoft to play" FontSize="10" Foreground="#8994A8"/><Button Content="Sign in" Margin="0,12,0,0" Background="#28243F" BorderBrush="#5A508B" Click="SignIn_Click"/></StackPanel>
      </Border>
      <TextBlock Text="ORBIT  •  EARLY ACCESS" Foreground="#586275" FontSize="9" Margin="10,18,0,0" CharacterSpacing="60"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="34,25,34,28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock x:Name="PageEyebrow" Text="YOUR SPACE" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="PageTitle" Text="Welcome back." FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock x:Name="PageSubtitle" Text="Everything you need for your next world, in one place." Foreground="#8994A8" FontSize="13" Margin="0,6,0,0"/></StackPanel><Border HorizontalAlignment="Right" Background="#151B26" BorderBrush="#293244" BorderThickness="1" CornerRadius="9" Padding="12,8" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#D6A85D" Margin="0,0,8,0"/><TextBlock Text="NOT CONNECTED" FontSize="9" Foreground="#AAB3C2" FontWeight="SemiBold" CharacterSpacing="70"/></StackPanel></Border></Grid>
    <Grid Grid.Row="1" Margin="0,28,0,0">
     <Grid.RowDefinitions><RowDefinition Height="2.1*"/><RowDefinition Height="Auto"/><RowDefinition Height="1.05*"/></Grid.RowDefinitions>
     <Border Grid.Row="0" CornerRadius="20" ClipToBounds="True" BorderBrush="#34324D" BorderThickness="1">
      <Grid>
       <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#24233B" Offset="0"/><GradientStop Color="#171D2B" Offset=".52"/><GradientStop Color="#101720" Offset="1"/></LinearGradientBrush></Grid.Background>
       <Canvas IsHitTestVisible="False" Opacity=".55"><Ellipse Width="410" Height="410" Canvas.Left="570" Canvas.Top="-175" Stroke="#7469B8" StrokeThickness="1"/><Ellipse Width="330" Height="330" Canvas.Left="610" Canvas.Top="-135" Stroke="#514A83" StrokeThickness="1"/><Ellipse Width="240" Height="240" Canvas.Left="655" Canvas.Top="-90" Stroke="#37365F" StrokeThickness="1"/><Ellipse Width="8" Height="8" Canvas.Left="900" Canvas.Top="95" Fill="#B4AAFF"/><Ellipse Width="4" Height="4" Canvas.Left="720" Canvas.Top="190" Fill="#A7A2DA"/></Canvas>
       <Grid Margin="36"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><Border Background="#302D4C" BorderBrush="#514A7D" BorderThickness="1" CornerRadius="6" Padding="9,5" HorizontalAlignment="Left"><TextBlock Text="THE NEXT SESSION STARTS HERE" FontSize="9" FontWeight="Bold" Foreground="#C5BFFF" CharacterSpacing="60"/></Border><TextBlock Text="Your worlds.\nYour way." FontSize="43" LineHeight="51" FontWeight="SemiBold" Margin="0,19,0,10"/><TextBlock Text="A better home for Minecraft Java Edition." FontSize="13" Foreground="#A8B0C2"/><StackPanel Orientation="Horizontal" Margin="0,26,0,0"><Button Content="  ▶   PLAY MINECRAFT" Background="#A99DFF" Foreground="#171522" BorderBrush="#C3BAFF" FontWeight="Bold" Padding="21,13" Click="Play_Click"/><Button Content="Manage instances" Background="#25283A" BorderBrush="#454963" Margin="10,0,0,0" Padding="17,13" Click="Instances_Click"/></StackPanel></StackPanel>
        <Grid Grid.Column="1" Margin="15,0,0,0"><Border Width="220" Height="220" CornerRadius="110" BorderBrush="#665D9E" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid><Ellipse Margin="17" Stroke="#514A83" StrokeThickness="1"/><Ellipse Margin="38" Stroke="#45416E" StrokeThickness="1"/><Ellipse Width="92" Height="92" Fill="#24213B" Stroke="#8C80D9" StrokeThickness="1.5"/><TextBlock Text="O" FontSize="58" FontWeight="Light" Foreground="#C2B9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><TextBlock Text="EXPLORE • CREATE • PLAY" Foreground="#8D88BC" FontSize="9" CharacterSpacing="120" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,9"/></Grid>
       </Grid>
      </Grid>
     </Border>
     <Grid Grid.Row="1" Margin="0,22,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#131923" BorderBrush="#273142" BorderThickness="1" CornerRadius="13" Padding="17" Margin="0,0,9,0"><StackPanel><TextBlock Text="GAME VERSION" Style="{StaticResource Eyebrow}"/><TextBlock Text="26.2" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Select a version in Instances" Foreground="#8792A5" FontSize="10"/></StackPanel></Border>
      <Border Grid.Column="1" Background="#131923" BorderBrush="#273142" BorderThickness="1" CornerRadius="13" Padding="17" Margin="5,0"><StackPanel><TextBlock Text="ACTIVE INSTANCE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Not configured" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="Create your first profile" Foreground="#8792A5" FontSize="10"/></StackPanel></Border>
      <Border Grid.Column="2" Background="#131923" BorderBrush="#273142" BorderThickness="1" CornerRadius="13" Padding="17" Margin="9,0,0,0"><StackPanel><TextBlock Text="MOD SUPPORT" Style="{StaticResource Eyebrow}"/><TextBlock Text="Ready to set up" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="Fabric • Forge • NeoForge" Foreground="#8792A5" FontSize="10"/></StackPanel></Border>
     </Grid>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#131923" BorderBrush="#273142" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,9,0"><StackPanel><TextBlock Text="GETTING STARTED" Style="{StaticResource Eyebrow}"/><TextBlock Text="Set up your launcher" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,13"/><TextBlock Text="01   Connect your Microsoft account" Foreground="#C7CEDA" FontSize="12" Margin="0,4"/><TextBlock Text="02   Choose a Minecraft version" Foreground="#C7CEDA" FontSize="12" Margin="0,4"/><TextBlock Text="03   Create an instance and play" Foreground="#C7CEDA" FontSize="12" Margin="0,4"/></StackPanel></Border>
      <Border Grid.Column="1" Background="#131923" BorderBrush="#273142" BorderThickness="1" CornerRadius="14" Padding="20" Margin="9,0,0,0"><StackPanel><TextBlock Text="BUILT FOR YOUR SETUP" Style="{StaticResource Eyebrow}"/><TextBlock Text="One launcher. More control." FontSize="18" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="Separate game instances, mod loaders, memory controls and modpack management — designed to stay organized." Foreground="#929DB0" FontSize="11" TextWrapping="Wrap" LineHeight="18"/><Button Content="Explore features  →" HorizontalAlignment="Left" Margin="0,13,0,0" Click="Browse_Click"/></StackPanel></Border>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>